# Copy to .env (npm start does this for you and generates fresh secrets).

# Database. A localhost URL starts the bundled embedded PostgreSQL; any other host (Neon, Supabase) is used as-is.
DATABASE_URL="postgresql://dev102:dev102pass@localhost:5432/dev102"

# API
PORT=4000
JWT_SECRET="change_me"
JWT_EXPIRES_IN=2h
CLIENT_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:4000"
APP_DOWNLOAD_URL="http://localhost:3000/download"
EVIDENCE_DIR=".data/evidence"
RETENTION_DAYS=30
OTP_TTL_MIN=5

# AI proctoring agent (FastAPI). The API and agent must share AGENT_API_KEY.
AGENT_URL="http://localhost:8000"
AGENT_API_KEY="dev-agent-key"
# Optional: enables LLM vision on screen frames and answer-seeking query checks.
# Any OpenAI-compatible provider works. Free options:
#   Gemini (aistudio.google.com/apikey): LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai", LLM_MODEL a current Flash model, e.g. "gemini-2.5-flash"
#   Hugging Face (huggingface.co/settings/tokens): LLM_BASE_URL="https://router.huggingface.co/v1", LLM_MODEL a vision model, e.g. "Qwen/Qwen2.5-VL-7B-Instruct"
LLM_API_KEY=""
LLM_MODEL="claude-sonnet-5-5"
LLM_BASE_URL="https://api.anthropic.com"
# Optional second provider, used when the first is rate-limited or failing.
LLM_FALLBACK_API_KEY=""
LLM_FALLBACK_MODEL=""
LLM_FALLBACK_BASE_URL=""

# Email. Leave SMTP_USER empty to write emails to the dev outbox (Dev toolbar → Outbox).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Leave blank to send from SMTP_USER; Gmail requires a verified alias for a different From address.
MAIL_FROM=""

# Optional: n8n webhook for CRITICAL-violation and auto-submit alerts. ALERT_WEBHOOK_KEY is sent as X-Alert-Key.
ALERT_WEBHOOK_URL=""
ALERT_WEBHOOK_KEY=""

# Optional TURN relay so the live screen view works across networks (mobile data, campus Wi-Fi). STUN alone only works on simple networks.
# Free plans: e.g. metered.ca (TURN server) or Cloudflare Realtime TURN. Comma-separate turn:/turns: URLs.
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Clients
NEXT_PUBLIC_API_URL="http://localhost:4000"
VITE_API_URL="http://localhost:4000"

# Browser extension (apps/extension). IDs allowed to call the API, comma-separated; the default matches the key in its manifest.
EXTENSION_IDS="fgfompcfejncbbpbipjokoniblfihbnm"
